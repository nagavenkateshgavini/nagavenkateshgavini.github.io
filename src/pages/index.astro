---
import BaseLayout from '../layouts/BaseLayout.astro';
const topics = [
  { number: '01', title: 'URL Shortener', level: 'Foundational', desc: 'Design short links, redirect traffic, and handle billions of mappings.', href: '/articles/url-shortener', tags: ['API design', 'Caching', 'Data modeling'] },
  { number: '02', title: 'Rate Limiter', level: 'Foundational → Intermediate', desc: 'Protect services from overload with limits that work across many servers.', href: '#coming-soon', tags: ['Redis', 'Algorithms', 'Distributed state'] },
  { number: '03', title: 'Notification System', level: 'Intermediate', desc: 'Deliver email, push, and SMS reliably at high volume.', href: '#coming-soon', tags: ['Queues', 'Retries', 'Idempotency'] },
  { number: '04', title: 'News Feed', level: 'Intermediate → Advanced', desc: 'Balance fan-out, freshness, ranking, and hot users.', href: '#coming-soon', tags: ['Fan-out', 'Caching', 'Scale'] },
  { number: '05', title: 'Chat Application', level: 'Intermediate → Advanced', desc: 'Explore real-time connections, ordering, delivery, and offline messages.', href: '#coming-soon', tags: ['WebSockets', 'Consistency', 'Presence'] },
  { number: '06', title: 'Video Streaming', level: 'Advanced', desc: 'Design upload pipelines, transcoding, object storage, and CDN delivery.', href: '#coming-soon', tags: ['CDN', 'Storage', 'Media'] },
];
---
<BaseLayout title="Home" description="System design interview preparation and practical engineering at scale.">
  <section class="hero">
    <div class="hero-copy">
      <div class="eyebrow">System Design · Engineering · Interviews</div>
      <h1>Design systems that work.<br /><span>At millions of requests.</span></h1>
      <p class="intro">A practical guide to system design interviews and the engineering decisions behind reliable, scalable software. Go beyond diagrams: understand trade-offs, bottlenecks, and failure modes.</p>
      <div class="actions"><a class="button" href="#topics">Explore design questions <span aria-hidden="true">↘</span></a><a class="button secondary" href="#approach">How to use this site</a></div>
      <div class="proof"><span><i></i> Requirements-first thinking</span><span><i></i> Real-world trade-offs</span><span><i></i> Follow-ups and edge cases</span></div>
    </div>
    <div class="architecture" aria-label="Illustrative system flow">
      <div class="arch-label">A system, at a glance</div>
      <div class="node client"><span>01</span><strong>Clients</strong><small>Web · Mobile · API</small></div>
      <div class="connector">↓ requests</div>
      <div class="node gateway"><span>02</span><strong>Load balancer</strong><small>Route · Protect · Observe</small></div>
      <div class="connector split">↙ &nbsp;&nbsp;&nbsp;&nbsp;&nbsp; ↘</div>
      <div class="node-row"><div class="node"><strong>Services</strong><small>Business logic</small></div><div class="node"><strong>Cache</strong><small>Fast reads</small></div></div>
      <div class="connector">↓ &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; ↘</div>
      <div class="node-row"><div class="node storage"><strong>Database</strong><small>Durable data</small></div><div class="node queue"><strong>Queue</strong><small>Async work</small></div></div>
      <div class="arch-foot"><span class="pulse"></span> Every component introduces trade-offs.</div>
    </div>
  </section>
  <section class="stats" aria-label="Learning approach"><div><strong>01</strong><span>Clarify the problem</span></div><div><strong>02</strong><span>Estimate the scale</span></div><div><strong>03</strong><span>Design & defend</span></div><div><strong>04</strong><span>Test failure modes</span></div></section>
  <section id="topics" class="topics-section">
    <div class="section-heading"><div><div class="eyebrow">The interview library</div><h2>Start with the classics.</h2><p>Learn one design at a time, from core concepts to interviewer follow-ups.</p></div><span class="count">06 STUDY PATHS</span></div>
    <div class="topic-grid">{topics.map((topic) => <a class="card topic-card" href={topic.href}><div class="topic-top"><span class="topic-number">{topic.number}</span><span class="tag">{topic.level}</span></div><h3>{topic.title}<span class="arrow"> ↗</span></h3><p>{topic.desc}</p><div class="tags">{topic.tags.map(tag => <span>{tag}</span>)}</div></a>)}</div>
  </section>
  <section id="approach" class="approach">
    <div><div class="eyebrow">A repeatable framework</div><h2>Not just what to build.<br /><span>Why it works — and when it fails.</span></h2><p class="muted">Every full guide follows a structure you can reuse in interviews and in production engineering.</p></div>
    <div class="steps"><div><b>01</b><span><strong>Requirements</strong><small>Users, use cases, SLOs, scope</small></span></div><div><b>02</b><span><strong>Capacity planning</strong><small>QPS, storage, bandwidth, peaks</small></span></div><div><b>03</b><span><strong>Architecture & deep dives</strong><small>APIs, data model, bottlenecks, trade-offs</small></span></div><div><b>04</b><span><strong>Failure cases & follow-ups</strong><small>Retries, races, outages, recovery</small></span></div></div>
  </section>
  <section id="about" class="about card"><div class="about-icon">∑</div><div><div class="eyebrow">About this project</div><h2>Built by an engineer who loves the why.</h2><p class="muted">System Design Lab is a growing collection of interview walkthroughs and practical notes on building software that remains reliable as it scales. The goal is clear reasoning, explicit trade-offs, and useful details—not magic architecture diagrams.</p><a class="text-link" href="https://github.com/nagavenkateshgavini">Explore my GitHub ↗</a></div></section>
  <p class="disclaimer">Interview questions are representative practice prompts, not a guarantee of what any company will ask.</p>
</BaseLayout>
<style>
.hero{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(32px,6vw,78px);align-items:center;padding:76px 0 58px}.hero h1{font-size:clamp(2.7rem,6.1vw,5.25rem);line-height:1.02;letter-spacing:-.075em;margin:22px 0}.hero h1 span,.approach h2 span{color:var(--mint)}.intro{font-size:1.08rem;line-height:1.8;color:#b8c3d7;max-width:600px}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}.proof{display:flex;gap:15px;flex-wrap:wrap;margin-top:28px;color:var(--muted);font-size:.78rem}.proof span{display:flex;align-items:center;gap:7px}.proof i,.pulse{width:7px;height:7px;background:var(--mint);border-radius:50%;display:inline-block}.architecture{border:1px solid #ffffff1a;background:linear-gradient(145deg,#15233a,#0e1627);border-radius:22px;padding:22px;box-shadow:0 24px 70px #0003}.arch-label{color:var(--muted);font-size:.75rem;text-transform:uppercase;letter-spacing:.13em;margin-bottom:18px}.node{position:relative;border:1px solid #57708f77;border-radius:12px;background:#17263b;padding:13px 15px;display:flex;flex-direction:column;gap:4px}.node span{font-size:.65rem;color:var(--mint)}.node strong{font-size:.88rem}.node small{font-size:.72rem;color:var(--muted)}.client,.gateway{width:76%;margin:auto;text-align:center}.gateway{border-color:#8ff0cf88;background:#17312f}.connector{text-align:center;color:var(--mint);font-size:.75rem;padding:7px}.node-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}.storage{border-color:#9bbcff77}.queue{border-color:#e0b2ff77}.arch-foot{border-top:1px solid #ffffff15;margin-top:17px;padding-top:15px;color:var(--muted);font-size:.73rem;display:flex;align-items:center;gap:9px}.stats{display:grid;grid-template-columns:repeat(4,1fr);border-block:1px solid #ffffff17;padding:22px 0;gap:14px}.stats div{display:flex;gap:12px;align-items:center}.stats strong{color:var(--mint);font-size:1.3rem}.stats span{color:var(--muted);font-size:.84rem}.topics-section{padding-top:84px}.count{color:var(--muted);font-size:.72rem;letter-spacing:.1em}.topic-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.topic-card{display:flex;flex-direction:column;min-height:238px}.topic-top{display:flex;justify-content:space-between;align-items:center;gap:10px}.topic-number{color:var(--mint);font-size:.8rem;font-weight:800}.topic-card h3{font-size:1.28rem;letter-spacing:-.04em;margin:25px 0 8px}.arrow{color:var(--mint);font-size:.9rem}.topic-card p{color:var(--muted);font-size:.88rem;line-height:1.65;margin:0 0 20px}.tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:auto}.tags span{font-size:.68rem;color:#c3cee0;background:#ffffff09;border:1px solid #ffffff10;border-radius:6px;padding:5px 7px}.approach{display:grid;grid-template-columns:1fr 1fr;gap:60px;padding:90px 0 30px}.approach h2{font-size:clamp(1.8rem,4vw,2.8rem);line-height:1.15;letter-spacing:-.06em}.approach p{line-height:1.7}.steps{display:grid;gap:0}.steps>div{display:flex;gap:18px;padding:17px 0;border-bottom:1px solid #ffffff16}.steps b{color:var(--mint);font-size:.8rem}.steps span{display:flex;flex-direction:column;gap:5px}.steps small{color:var(--muted);font-size:.82rem}.about{display:grid;grid-template-columns:60px 1fr;gap:22px;margin-top:60px;align-items:start}.about-icon{display:grid;place-items:center;width:54px;height:54px;border:1px solid #8ff0cf55;border-radius:16px;color:var(--mint);font-size:1.7rem}.about h2{margin:10px 0;font-size:1.5rem;letter-spacing:-.04em}.about p{max-width:760px;line-height:1.8}.text-link{color:var(--mint);font-size:.9rem;font-weight:700}.disclaimer{margin-top:24px;color:#71809a;font-size:.75rem}
@media(max-width:850px){.hero{grid-template-columns:1fr;padding-top:56px}.architecture{max-width:540px;width:100%;margin:auto}.topic-grid{grid-template-columns:repeat(2,1fr)}.approach{gap:28px}}
@media(max-width:580px){.stats{grid-template-columns:repeat(2,1fr)}.topic-grid{grid-template-columns:1fr}.topic-card{min-height:0}.approach{grid-template-columns:1fr;padding-top:64px}.section-heading{align-items:flex-start;flex-direction:column}.about{grid-template-columns:1fr}.hero h1{font-size:clamp(2.6rem,13vw,4rem)}}
</style>