---
const { title = 'System Design Lab', description = 'Practical system design, scalability, reliability, and interview preparation.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1020" />
    <title>{title} · System Design Lab</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="System Design Lab home"><span class="brand-mark">S</span><span>System Design <span class="muted-brand">Lab</span></span></a>
      <nav aria-label="Main navigation">
        <a href="/#topics">Topics</a>
        <a href="/articles/url-shortener">First guide</a>
        <a href="/#about">About</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <span>Built to think clearly about systems at scale.</span>
      <a href="https://github.com/nagavenkateshgavini">GitHub ↗</a>
    </footer>
  </body>
</html>
<style is:global>
  :root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#e8edf8;background:#0b1020;font-synthesis:none;text-rendering:optimizeLegibility;-webkit-font-smoothing:antialiased;--muted:#9ba8c0;--line:#253047;--panel:#111a2d;--mint:#8ff0cf;--blue:#9bbcff}
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{margin:0;min-height:100vh;background:radial-gradient(ellipse at 50% -20%,#203552 0,transparent 52%),#0b1020}
  a{color:inherit;text-decoration:none}
  a:focus-visible,button:focus-visible{outline:2px solid var(--mint);outline-offset:4px}
  .site-header,.site-footer{width:min(1120px,calc(100% - 40px));margin:auto;display:flex;align-items:center;justify-content:space-between;gap:20px}
  .site-header{padding:24px 0;border-bottom:1px solid #ffffff12}
  .brand{display:flex;align-items:center;gap:10px;font-weight:750;letter-spacing:-.03em}
  .brand-mark{display:grid;place-items:center;width:32px;height:32px;border-radius:10px;background:var(--mint);color:#0b1020;font-weight:900}
  .muted-brand{color:var(--muted);font-weight:500}
  nav{display:flex;gap:24px;color:var(--muted);font-size:.9rem}
  nav a:hover,.site-footer a:hover{color:var(--mint)}
  main{width:min(1120px,calc(100% - 40px));margin:auto}
  .site-footer{padding:28px 0 36px;margin-top:70px;border-top:1px solid #ffffff12;color:var(--muted);font-size:.85rem}
  .eyebrow{color:var(--mint);font-size:.75rem;font-weight:800;letter-spacing:.18em;text-transform:uppercase}
  .muted{color:var(--muted)}
  .button{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:12px 16px;border-radius:12px;background:var(--mint);color:#0b1020;font-weight:800;font-size:.9rem}
  .button.secondary{background:transparent;border:1px solid #ffffff2b;color:#e8edf8}
  .button:hover{transform:translateY(-1px)}
  .section-heading{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:22px}
  .section-heading h2{font-size:clamp(1.6rem,4vw,2.1rem);letter-spacing:-.05em;margin:0}
  .section-heading p{margin:8px 0 0;color:var(--muted)}
  .card{background:linear-gradient(145deg,#141f34,#101728);border:1px solid #ffffff15;border-radius:18px;padding:22px;transition:border-color .2s,transform .2s}
  .card:hover{border-color:#8ff0cf66;transform:translateY(-2px)}
  .tag{display:inline-block;padding:5px 9px;border:1px solid #8ff0cf33;border-radius:999px;color:var(--mint);font-size:.75rem}
  @media(max-width:620px){.site-header{align-items:flex-start;flex-direction:column}.site-header nav{gap:17px;flex-wrap:wrap}.site-footer{align-items:flex-start;flex-direction:column}.site-header,main,.site-footer{width:calc(100% - 32px)}}
</style>